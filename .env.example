# Copie ce fichier vers ".env" et remplis tes valeurs
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=TA_CLE_ICI
OLLAMA_MODEL=glm-5.3-flash:cloud
PORT=3000
# URL HTTPS stable si l'application est hébergée (optionnel en local).
LUMI_PUBLIC_URL=

# Modele vision (photos du cahier). Doit etre multimodal.
OLLAMA_VISION_MODEL=gemma4:31b

# === Mode heberge (Render, optionnel) ===
# Code d'acces demande a l'ouverture (protege ta cle API). Laisser vide en local.
LUMI_ACCESS_CODE=
# Stockage persistant gratuit (https://upstash.com -> creer une base -> REST) :
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Pas de serveur HTTPS auto-signe (l'hebergeur fournit deja le vrai HTTPS)
NO_HTTPS=1

# === Freemium (gatekeeper : protege le credit Ollama en vente) ===
# 1 (defaut) = mode maison, tout illimite, aucun compte requis pour Manon.
# 0 = mode vente : connexion famille obligatoire, quotas actifs.
LUMI_LOCAL_MODE=
# Echanges/jour maximum sur le plan gratuit et les essais expires (defaut 20).
LUMI_FREE_DAILY=20
# Code admin pour la page de gestion des clients (/admin.html). Vide = desactivee.
LUMI_ADMIN_CODE=
