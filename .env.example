# Copie ce fichier vers ".env" et remplis tes valeurs
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=TA_CLE_ICI
OLLAMA_MODEL=glm-5.3-flash:cloud
PORT=3000
# URL HTTPS stable si l'application est hébergée (optionnel en local).
LUMI_PUBLIC_URL=

# Modele vision (photos du cahier). Doit etre multimodal.
OLLAMA_VISION_MODEL=gemma4:31b

# IA de secours quand le modele principal est surcharge (429/5xx/timeout).
# Vide = pas de secours.
OLLAMA_FALLBACK_MODEL=deepseek-v4.1-flash:cloud

# === Mode heberge (Render, optionnel) ===
# Code d'acces demande a l'ouverture (protege ta cle API). Laisser vide en local.
LUMI_ACCESS_CODE=
# Stockage persistant gratuit (https://upstash.com -> creer une base -> REST) :
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Pas de serveur HTTPS auto-signe (l'hebergeur fournit deja le vrai HTTPS)
NO_HTTPS=1

# === Freemium (gatekeeper : protege le credit Ollama en vente) ===
# 1 (defaut) = mode maison, tout illimite, aucun compte requis pour Manon.
# 0 = mode vente : connexion famille obligatoire, quotas actifs.
LUMI_LOCAL_MODE=
# Quota demo du plan gratuit, AU TOTAL (une fois) : appels IA (defaut 20).
LUMI_FREE_DAILY=20
# Quota demo fiches de revision, au total (defaut 5).
LUMI_FREE_WEEKLY_FICHES=5
# Code admin pour la page de gestion des clients (/admin.html). Vide = desactivee.
LUMI_ADMIN_CODE=

# Notifications privees des nouvelles demandes (Resend, jamais dans public/).
LUMI_ADMIN_EMAIL=
RESEND_API_KEY=
LUMI_EMAIL_FROM=Lumi <onboarding@resend.dev>
LUMI_PUBLIC_URL=https://lumi-revisions.onrender.com

# SMS Free Mobile (code demo vers le numero perso, gratuit, illimite vers soi).
# Identifiant = numero Free Mobile ; pass = cle API generee dans
# l'Espace Abonne Free > Mes options > Notification SMS.
FREE_MOBILE_USER=
FREE_MOBILE_PASS=

# Dictée CPU sans Docker (hébergement o2switch ; facultatif)
# WHISPER_PYTHON=/home/USER/lumi-backend/.lumi-whisper/venv/bin/python
# WHISPER_MODEL_PATH=/home/USER/lumi-backend/.lumi-whisper/models/small
# WHISPER_MODEL_SIZE=small
